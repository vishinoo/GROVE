# Grove — copy to .env and fill in.
# EXPO_PUBLIC_* values are inlined into the JS bundle at build time, so a
# change here needs Metro restarted, not just a hot reload.

# ── Noctus backend ───────────────────────────────────────────────────────────
# Must be the machine's LAN IP, not localhost — a phone cannot resolve
# localhost to your Mac. This drifts when your DHCP lease renews; if Grove
# says it cannot reach Noctus, check this first with: ipconfig getifaddr en0
EXPO_PUBLIC_NOCTUS_URL=

# ── Sign-in ──────────────────────────────────────────────────────────────────
# Noctus's own Supabase project. Signing in here signs you in to Noctus.
EXPO_PUBLIC_NOCTUS_SUPABASE_URL=
EXPO_PUBLIC_NOCTUS_SUPABASE_ANON_KEY=

# 1 shows the "Continue as dev" button, which skips Supabase entirely and
# authenticates as the literal string `dev-token`. Needs DEV_AUTH_BYPASS=true on the backend. Also gated on __DEV__, so it
# cannot reach a release build even if left at 1.
EXPO_PUBLIC_ALLOW_DEV_LOGIN=0

# ── The cheap tier ───────────────────────────────────────────────────────────
# Ordinary conversation and tool summaries go here instead of Indy, which is
# capped at 2 messages/hour on the free plan. With BOTH of these unset every
# single message hits that cap — you will exhaust it in about a minute of
# testing and Grove will only be able to say so.
#
# Ollama is tried first and costs nothing at all. It is LAN-only: the phone and
# this Mac must share a network, and it needs OLLAMA_HOST=0.0.0.0 set when you
# start it, or it will only listen on localhost and the phone cannot reach it.
#   brew install ollama
#   ollama pull llama3.2:1b            # the 1b is the cheapest useful one
#   OLLAMA_HOST=0.0.0.0 ollama serve
EXPO_PUBLIC_OLLAMA_URL=
EXPO_PUBLIC_OLLAMA_MODEL=llama3.2:1b

# Fallback when Ollama is unreachable. Paste a key from
# https://aistudio.google.com/apikey — the free tier is enough for testing.
#
# WARNING: this key is compiled into the bundle and is extractable from any
# release build. Use a throwaway key and do not ship a build with it set. The
# real fix is a /api/chat/light endpoint on Noctus holding the key, the way
# /api/indy/chat already does. Everything outside src/lib/lightModel.ts is
# provider-agnostic, so that swap is one file.
EXPO_PUBLIC_GEMINI_API_KEY=
# The cheap tier. Verified against Google's pricing page on 2026-09-05:
# gemini-2.5-flash-lite is $0.10/1M in, $0.40/1M out — cheaper than every
# newer lite model (3.1-flash-lite is $0.25/$1.50, 3.5-flash-lite $0.30/$2.50).
# Newer is not cheaper here. Re-check before changing it.
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash-lite

# Used only for the handful of turns the cheap one cannot serve — see
# needsDepth() in lightModel.ts. Leave it unset and everything uses the model
# above, which is the right default until something actually needs more.
# gemini-3.1-flash-lite is the next rung at $0.25/$1.50.
EXPO_PUBLIC_GEMINI_MODEL_DEEP=

# ── Dev conveniences ─────────────────────────────────────────────────────────
# 1 = replay the intro on every launch. Set to 0 once you have seen it enough.
EXPO_PUBLIC_ALWAYS_ONBOARD=0

# Google iOS OAuth client (no secret — installed apps use PKCE).
# Create at console.cloud.google.com > Credentials > OAuth client ID > iOS
# Bundle ID must match app.json (org.noctusai.grove).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# The agent bridge on your Mac. Unset means the ability does not exist at all.
#
# This runs an AI agent with a shell on that machine, so the token is the only
# thing between anything on your network and it. Generate one, do not invent one:
#   export GROVE_BRIDGE_TOKEN="$(openssl rand -hex 24)"
#   node bridge/grove-bridge.mjs
EXPO_PUBLIC_MAC_URL=
EXPO_PUBLIC_MAC_TOKEN=
