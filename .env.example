# Grove — copy to .env and fill in.
EXPO_PUBLIC_NOCTUS_URL=https://www.noctusai.org

# Noctus's Supabase project. Same values as Noctus Frontend's
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY — signing in here signs you in
# to Noctus. The anon key is a public client key; never ship the service key.
EXPO_PUBLIC_NOCTUS_SUPABASE_URL=
EXPO_PUBLIC_NOCTUS_SUPABASE_ANON_KEY=

# 1 enables the dev sign-in button (needs DEV_AUTH_BYPASS=true on the backend).
# Also gated on __DEV__ in code, so this cannot reach a release build even if
# it is set when that build is made.
EXPO_PUBLIC_ALLOW_DEV_LOGIN=0

# ── The cheap tier (TESTING ONLY) ────────────────────────────────────────────
# Ordinary conversation and tool-run summaries go here instead of Indy, whose
# free plan allows 2 messages an hour. Leave both unset and every message goes
# to Indy — which, spoken aloud, runs out by lunchtime.
#
# WARNING: EXPO_PUBLIC_* values are compiled into the JS bundle, so this key is
# extractable from any release build. Use a throwaway key, and do not ship a
# build with it set. The real fix is a /api/chat/light endpoint on Noctus
# holding the key, the way /api/indy/chat already does.
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash-lite

# Preferred over Gemini when reachable, because it's free. LAN only: the phone
# and the machine must share a network, and it needs OLLAMA_HOST=0.0.0.0.
EXPO_PUBLIC_OLLAMA_URL=
EXPO_PUBLIC_OLLAMA_MODEL=llama3.2

# Dev only: 1 = show the intro on every launch while working on it. Ignored in
# release builds. Leave unset for the normal once-per-device behaviour.
EXPO_PUBLIC_ALWAYS_ONBOARD=0
